# Local development environment variables. Copy to `.env` and fill in real
# values — `.env` is gitignored, never commit real secrets. See
# docs/environment-variables.md for the full reference (what each variable
# protects, which environments need it, how to generate a value) and
# docs/milestone-8-subphase-a-production-architecture-research.md Section 13
# for the original production-readiness audit that identified SCHEDULER_SECRET
# as undocumented.

DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce_intel?schema=public"

# Required. Generate with: openssl rand -base64 32
# Unique per environment — never share between local/staging/production.
AUTH_SECRET=""

# REQUIRED in staging/production on any non-Vercel host (Render, Fly.io, etc).
# Auth.js only auto-trusts the request Host header when NODE_ENV !== "production"
# (true for local `next dev`) or when AUTH_URL/VERCEL/CF_PAGES is set — none of
# which apply to a `next start` deployment on Render. Without this, every
# Auth.js endpoint (/api/auth/session, /csrf, /providers, sign-in callbacks)
# fails closed with an UntrustedHost error — discovered by running a real
# `next start` locally in Milestone 8 Sub-phase C. Not needed locally (`next
# dev` already trusts the host). See https://errors.authjs.dev#untrustedhost.
AUTH_TRUST_HOST="true"

# Optional — omit to run without Google/Facebook sign-in (the Credentials
# email/password provider still works with none of these set).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Optional locally — required for marketing/scheduler.ts and
# scripts/marketing-scheduler-tick.ts (Google advertising intelligence via
# SerpApi's Ads Transparency Center API, see src/lib/marketing/source-factory.ts).
# Without it, marketing collection is simply never triggered — every other
# feature works unaffected. Get a key at https://serpapi.com/manage-api-key.
SERPAPI_API_KEY=""

# Optional locally, REQUIRED in staging/production — authenticates calls to
# POST /api/internal/scheduler/tick and .../marketing-tick (the
# "x-scheduler-secret" request header). Both routes fail CLOSED (HTTP 503)
# if this is unset, so local `next dev` works fine without it as long as you
# only trigger crawls via `npm run scheduler:tick` / `npm run
# marketing-scheduler:tick` (which call the scheduler functions directly,
# not over HTTP) rather than the HTTP routes themselves.
# Generate with: openssl rand -base64 32
SCHEDULER_SECRET=""

# Optional — defaults to 1 (Render puts exactly one reverse proxy in front of
# the web service). How many x-forwarded-for entries, counted from the
# right, come from proxies you actually trust — see
# src/lib/security/rate-limit.ts's getClientIp(). 0 means "no proxy at all,
# ignore x-forwarded-for entirely." Only change this if the deployment
# topology changes (e.g. a CDN added in front of Render).
TRUSTED_PROXY_HOPS="1"
