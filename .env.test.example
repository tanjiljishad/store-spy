# No `?schema=` — app tables live in the `store_spy` schema since the
# control-plane split; raw SQL (incl. every integration test's TRUNCATE) needs
# `store_spy` in search_path, while `prisma migrate` needs `public`. This
# `options=-c search_path=store_spy,public` form is the only one that serves
# both. See .env.test's own comment and docs/environment-variables.md.
DATABASE_URL="postgresql://app:app@localhost:5433/ecom_intel_test?options=-c%20search_path%3Dstore_spy%2Cpublic"
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Optional — omit to run without Google/Facebook sign-in (Credentials still works).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Optional — required only for marketing/scheduler.ts and scripts/marketing-scheduler-tick.ts
# (Google advertising intelligence via SerpApi's Ads Transparency Center API,
# see src/lib/marketing/source-factory.ts). Without it, marketing collection
# is simply never triggered — every other feature works unaffected. Get a key
# at https://serpapi.com/manage-api-key. Never commit a real value here.
SERPAPI_API_KEY=""
# Optional in tests — required in staging/production to authenticate calls to
# POST /api/internal/scheduler/tick and .../marketing-tick (the "x-scheduler-secret"
# header). Both routes fail CLOSED (503) if this is unset, so integration
# tests that don't exercise those two routes directly work fine without it.
# See docs/environment-variables.md for what it protects and how to generate one.
SCHEDULER_SECRET="generate-with: openssl rand -base64 32"
# Required by the entitlements route's own tests (they assert the fail-closed
# 503 / 401 gate). Any non-empty value works for tests.
CONTROL_PLANE_INTERNAL_SECRET="test-only-internal-entitlements-secret-do-not-use-in-prod"
