# Copy to deploy/deploy.env ON THE DEPLOY HOST, fill in, then: chmod 600 deploy/deploy.env
# deploy/deploy.env is gitignored — it holds a real token. This .example file is safe to commit.
#
# The host also needs a normal application `.env` next to the compose files
# (AUTH_SECRET, DATABASE_URL if managed, OAuth keys, ...) — see .env.example.
# This file is ONLY the extra bits deploy/contabo-deploy.sh needs.

# --- GHCR pull authentication ---------------------------------------------------
# GHCR packages are private by default, so the host must `docker login` before it
# can pull. The deploy script does that with these two values.

# GitHub username (or org login) that can read the package.
GHCR_USER=your-github-username

# GitHub Personal Access Token (classic) with ONLY the `read:packages` scope.
# NOT your GitHub password. Create at https://github.com/settings/tokens
# Rotate immediately if it leaks. A fine-grained token with "Packages: read" works too.
GHCR_TOKEN=

# --- Image selection ----------------------------------------------------------
# The image CI pushes, WITHOUT a tag. Lowercase. Matches
# `ghcr.io/${{ github.repository }}` in .github/workflows/ci.yml.
IMAGE=ghcr.io/tanjiljishad/store-spy

# Tag to run. `latest` follows main. Pin to `sha-<short>` or `vX.Y.Z` (both are
# pushed by CI) to deploy or roll back to a specific known-good build.
IMAGE_TAG=latest

# --- Host housekeeping -------------------------------------------------------
# How many past image versions to keep on the host after a successful deploy.
# The image is ~1.2 GB; a 75 GB VPS holds well under 60 of them before other
# data (Postgres volume, logs) is squeezed. 3 = current + two rollback targets.
KEEP_IMAGES=3

# Host port the web container publishes. Must match your reverse proxy / firewall.
# The deploy script also probes http://localhost:${WEB_PORT}/api/health.
WEB_PORT=3000

# Password for the in-stack Postgres (compose interpolates it). Leave blank and
# ignore if you point DATABASE_URL at managed Postgres instead
# (see docker-compose.prod.yml).
POSTGRES_PASSWORD=
