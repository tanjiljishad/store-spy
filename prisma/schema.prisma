// Ecommerce Intelligence Engine — data model
//
// Design rules that must not be broken:
//   1. `Event` is append-only and immutable. Never UPDATE, never DELETE.
//   2. Events are computed at crawl time and persisted. Never derived at read time.
//   3. `Product` holds CURRENT state (fast diffing: one query per store).
//      `ProductStateSnapshot` holds history, written ONLY when something changed.
//   4. Every write path is idempotent, keyed on (crawlId, dedupeKey).

generator client {
  provider        = "prisma-client-js"
  // multiSchema is still a preview feature on Prisma 5.x (GA in 6.0). Needed
  // so `store_spy` (this product's own data) and `control_plane` (the shared
  // identity/billing/entitlements layer, see Task B) can live as two schemas
  // in one Postgres instance.
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Order is cosmetic only. Every model and enum carries an explicit
  // @@schema(...) — nothing lands in `public` except _prisma_migrations.
  //
  // DATABASE_URL must set search_path (store_spy first, then public) via
  // `?options=-c search_path=store_spy,public` and must NOT set `?schema=`.
  // Raw SQL uses bare names resolved via search_path; `?schema=` pins it and
  // Prisma then ignores `options`. See docs/environment-variables.md.
  schemas  = ["control_plane", "store_spy"]
}

// ---------------------------------------------------------------------------
// Stores
// ---------------------------------------------------------------------------

enum Platform {
  SHOPIFY
  WOOCOMMERCE
  BIGCOMMERCE
  MAGENTO
  CUSTOM
  UNKNOWN

  @@schema("store_spy")
}

/// Crawl frequency tier. Driven by user attention, not by store size.
enum CrawlTier {
  HOT // any store with >=1 ACTIVE watch    -> every 6-12h
  WARM // searched within last 30 days      -> daily
  COOL // searched at least once, ever      -> weekly
  COLD // corpus-seeded, never searched     -> monthly
  DORMANT // 3+ crawls with zero change        -> quarterly
  DISABLED // dead domain / blocked / opted out  -> never

  @@schema("store_spy")
}

model Store {
  id       String    @id @default(cuid())
  domain   String    @unique // canonical: lowercase, no www, no protocol
  platform Platform  @default(UNKNOWN)
  tier     CrawlTier @default(COLD)

  name         String?
  currency     String? @db.VarChar(3)
  countryCode  String? @db.VarChar(2)
  themeName    String?
  themeVersion String?

  /// True once we have completed one successful full crawl.
  /// Until then, diffing emits NO alertable events (see engine.ts baseline guard).
  baselinedAt          DateTime?
  /// Same role as baselinedAt, for the independent marketing-intelligence
  /// pipeline: null until the first successful MarketingCollectionRun, so
  /// every ad found on that first check is persisted but does not fire a
  /// flood of AD_DETECTED events for advertising that already existed.
  marketingBaselinedAt DateTime?

  firstSeenAt               DateTime  @default(now())
  lastCrawledAt             DateTime?
  lastChangedAt             DateTime?
  nextCrawlAt               DateTime  @default(now())
  /// Same claim mechanics as nextCrawlAt (FOR UPDATE SKIP LOCKED in
  /// marketing/scheduler.ts) but on its own, much slower cadence — this
  /// drives a paid external vendor, so it must never be conflated with or
  /// derived from the free Shopify crawl schedule.
  nextMarketingCollectionAt DateTime  @default(now())

  /// Consecutive crawls where catalogHash was unchanged. Drives DORMANT demotion.
  unchangedStreak Int @default(0)
  /// Consecutive failed crawls. Drives DISABLED demotion.
  failureStreak   Int @default(0)

  /// RDAP-derived domain registration date (see lib/enrichment/domain-age.ts)
  /// — looked up once and cached forever, since a domain's registration date
  /// never changes. Null until the lookup has been attempted or found nothing.
  domainRegisteredAt DateTime?
  /// Earliest Wayback Machine snapshot date found for this domain's
  /// /products.json, looked up alongside domainRegisteredAt. Null until
  /// attempted or found nothing.
  firstArchivedAt    DateTime?
  /// Set the first time the enrichment lookups above are attempted, whether
  /// or not they found anything — distinguishes "never tried" (null) from
  /// "tried, found nothing" (set, fields above still null), so a store whose
  /// registrar redacts RDAP data or has no Wayback history isn't retried on
  /// every crawl.
  domainAgeCheckedAt DateTime?

  products                Product[]
  entities                StoreEntity[]
  crawls                  Crawl[]
  events                  Event[]
  watchers                Watchlist[]
  analysisUsage           AnalysisUsage[]
  adObservations          AdObservation[]
  marketingCollectionRuns MarketingCollectionRun[]
  stats                   StoreStats?

  @@index([tier, nextCrawlAt])
  @@index([platform])
  @@schema("store_spy")
}

/// Rolling behavioural stats. Used by the significance scorer for the RARITY term:
/// a price change at a store that never changes prices matters far more than one
/// at a store that reprices every day.
model StoreStats {
  storeId String @id
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  windowDays Int @default(30)

  priceChangesInWindow    Int @default(0)
  productsAddedInWindow   Int @default(0)
  productsRemovedInWindow Int @default(0)
  crawlsInWindow          Int @default(0)

  /// Cached medians so the scorer never has to aggregate at read time.
  medianPriceCents Int?
  productCount     Int  @default(0)

  computedAt DateTime @default(now())

  @@schema("store_spy")
}

// ---------------------------------------------------------------------------
// Crawls
// ---------------------------------------------------------------------------

enum CrawlStatus {
  RUNNING
  OK
  PARTIAL // some pages failed — additions are trusted, removals are NOT
  FAILED
  BLOCKED

  @@schema("store_spy")
}

/// MANUAL: a user submitted a URL (POST /api/analyze). SCHEDULED: the
/// monitoring scheduler claimed a due store. Purely observability — nothing
/// in the diff engine or persistence path treats these differently.
enum CrawlTrigger {
  MANUAL
  SCHEDULED

  @@schema("store_spy")
}

model Crawl {
  id      String       @id @default(cuid())
  storeId String
  store   Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  trigger CrawlTrigger @default(MANUAL)

  status     CrawlStatus @default(RUNNING)
  startedAt  DateTime    @default(now())
  finishedAt DateTime?

  /// Hash of the normalized catalog EXCLUDING volatile ordering fields.
  /// If unchanged vs. previous crawl, the entire product diff is skipped.
  catalogHash String? @db.VarChar(64)
  /// Separate hash for bestseller ordering. Changes almost daily, so it is kept
  /// out of catalogHash to preserve the short-circuit.
  rankHash    String? @db.VarChar(64)
  techHash    String? @db.VarChar(64)

  pagesExpected Int?
  pagesFetched  Int?
  productCount  Int?
  httpErrors    Int     @default(0)
  durationMs    Int?
  errorMessage  String?

  events             Event[]
  snapshots          ProductStateSnapshot[]
  reviewObservations StorefrontReviewObservation[]

  @@index([storeId, startedAt(sort: Desc)])
  @@schema("store_spy")
}

// ---------------------------------------------------------------------------
// Products — current state
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  MISSING // absent from last crawl(s), not yet confirmed gone
  REMOVED // confirmed after N consecutive absences

  @@schema("store_spy")
}

model Product {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Shopify product id as string. Stable across handle/title renames.
  externalId  String
  handle      String
  title       String
  vendor      String?
  productType String?
  tags        String[]

  /// Shopify's own created_at. Lets us reconstruct a launch timeline
  /// retroactively from a single first crawl.
  sourceCreatedAt DateTime?

  status        ProductStatus @default(ACTIVE)
  firstSeenAt   DateTime      @default(now())
  lastSeenAt    DateTime      @default(now())
  missingSince  DateTime?
  /// Consecutive successful crawls in which this product was absent.
  missingStreak Int           @default(0)

  // --- current state (denormalized for single-query diffing) ---
  priceMinCents     Int
  priceMaxCents     Int
  compareAtMaxCents Int?
  variantCount      Int     @default(0)
  availableVariants Int     @default(0)
  bestsellerRank    Int?
  imageHash         String? @db.VarChar(32) // perceptual hash, for cross-store matching

  snapshots          ProductStateSnapshot[]
  adObservations     AdObservation[]
  reviewObservations StorefrontReviewObservation[]

  @@unique([storeId, externalId])
  @@index([storeId, status])
  @@index([imageHash])
  @@schema("store_spy")
}

/// Append-only. One row per product PER CHANGE — not per crawl.
/// This is what makes price-history charts cheap and storage sane.
model ProductStateSnapshot {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  crawlId   String
  crawl     Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  capturedAt        DateTime @default(now())
  priceMinCents     Int
  priceMaxCents     Int
  compareAtMaxCents Int?
  variantCount      Int
  availableVariants Int
  bestsellerRank    Int?

  @@index([productId, capturedAt(sort: Desc)])
  @@schema("store_spy")
}

/// Bounded, per-product review-count observation from public storefront
/// JSON-LD (Milestone 9 Sub-phase E) — never from a review-provider API; see
/// docs/milestone-9-subphase-b-completion-report.md for why that route
/// remains blocked (Okendo's Terms of Service). Deliberately a separate
/// table from ProductStateSnapshot: that one is written for every ACTIVE
/// product on every crawl with a change, while this is written only for a
/// small, bounded, provider-aware SAMPLE of products per crawl (see
/// reviews/sampling.ts) — a fundamentally different collection cadence that
/// would leave most ProductStateSnapshot rows null if merged into it.
model StorefrontReviewObservation {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  crawlId   String
  crawl     Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  /// Null means "this product's page was sampled and fetched successfully,
  /// but no usable review count was found in its storefront JSON-LD" — an
  /// explicit, honest "not observed," never coerced to 0. A real 0 (a
  /// product whose page genuinely emits a zero-review AggregateRating) is a
  /// legitimate, distinct value from null.
  reviewCount     Int?
  ratingValue     Float?
  /// Free text, not an enum — mirrors AdObservation.source: a future
  /// non-JSON-LD storefront source shouldn't require a migration.
  source          String  @default("storefront_jsonld")
  /// Review app detected on the store at sampling time, if any (e.g.
  /// "okendo") — sampling/attribution context only, never proof this
  /// specific count actually came from that provider (see review-infrastructure.ts).
  provider        String?
  /// True when 2+ products sampled in the SAME crawl reported the exact same
  /// non-null reviewCount — a real, observed signal (product-group/variant
  /// sharing, confirmed live in Milestone 9 Sub-phase D) that this count may
  /// not be independent per product. Never deduplicated or summed
  /// automatically — see reviews/collect.ts and the hard "no store totals"
  /// rule in reviews/signal.ts.
  sharedWithGroup Boolean @default(false)

  observedAt DateTime @default(now())

  @@unique([productId, crawlId])
  @@index([productId, observedAt(sort: Desc)])
  /// Milestone 9 Sub-phase F: getReviewCoverageSummary()'s crawlId-only
  /// lookup was a real, confirmed sequential scan (EXPLAIN ANALYZE at
  /// 135,000 synthetic rows: 31.7ms, scanning every row in the table) —
  /// the (productId, crawlId) composite unique index above cannot serve a
  /// crawlId-only WHERE clause, since crawlId isn't its leading column.
  /// This query's cost was scaling with total system-wide row count across
  /// every store/crawl, not with any bounded sample size. Confirmed fixed
  /// by EXPLAIN ANALYZE after adding this index — see the Sub-phase F report.
  @@index([crawlId])
  @@schema("store_spy")
}

// ---------------------------------------------------------------------------
// Store entities — apps, pixels, collections, payment providers
//
// Same shape as Product for the same reason: a named thing that appears,
// persists, and disappears goes through the same ACTIVE -> MISSING -> REMOVED
// state machine (see diffEntitySet() in engine). Columns on Store can't give
// you a dated "installed Klaviyo on 14 March" or a reverse lookup across the
// whole corpus ("which stores use Zipify OCU") — a table can, for free.
// ---------------------------------------------------------------------------

enum StoreEntityKind {
  APP
  PIXEL
  COLLECTION
  PAYMENT_PROVIDER
  /// Reserved — not yet populated. emailPlatform is a scalar ("which ESP, if
  /// any"), not set membership, so it doesn't fit diffEntitySet() as-is.
  EMAIL_PLATFORM

  @@schema("store_spy")
}

model StoreEntity {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  kind StoreEntityKind
  /// Natural key within (storeId, kind): app slug, pixel platform, collection handle.
  key  String
  /// Extra data that isn't part of identity: pixel ID, theme/app version.
  meta Json?

  status        ProductStatus @default(ACTIVE)
  firstSeenAt   DateTime      @default(now())
  lastSeenAt    DateTime      @default(now())
  missingSince  DateTime?
  /// Consecutive successful crawls in which this entity was absent.
  missingStreak Int           @default(0)

  @@unique([storeId, kind, key])
  @@index([storeId, kind, status])
  /// Reverse lookup across the whole corpus: "which stores use Zipify OCU".
  @@index([kind, key])
  @@schema("store_spy")
}

// ---------------------------------------------------------------------------
// Events — the heart of the product
// ---------------------------------------------------------------------------

enum EventType {
  STORE_BASELINED
  PRODUCT_ADDED
  PRODUCT_REMOVED
  PRODUCT_RESTORED
  PRICE_DROP
  PRICE_INCREASE
  SALE_STARTED
  SALE_ENDED
  PRODUCT_SOLD_OUT
  PRODUCT_RESTOCKED
  VARIANT_SOLD_OUT
  BESTSELLER_ENTERED
  BESTSELLER_CLIMBED
  BESTSELLER_DROPPED
  COLLECTION_ADDED
  COLLECTION_REMOVED
  THEME_CHANGED
  APP_ADDED
  APP_REMOVED
  PIXEL_ADDED
  PIXEL_REMOVED
  PAYMENT_PROVIDER_ADDED
  PAYMENT_PROVIDER_REMOVED
  AD_DETECTED
  AD_REMOVED
  AD_CHANGED
  PRODUCT_AD_MATCHED

  @@schema("store_spy")
}

enum EntityType {
  STORE
  PRODUCT
  VARIANT
  COLLECTION
  TECH
  AD

  @@schema("store_spy")
}

model Event {
  id      String  @id @default(cuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Null for events not produced by a Shopify crawl (e.g. Marketing
  /// Intelligence events — see AdObservation). Every existing Shopify-crawl
  /// code path still always supplies a real crawlId; this was widened, not
  /// repurposed.
  crawlId String?
  crawl   Crawl?  @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  entityType EntityType
  /// Stable natural key of the subject: product externalId, collection handle, app slug…
  entityKey  String
  eventType  EventType

  oldValue Json?
  newValue Json?

  /// 0..100. Computed at write time by significance.ts. Never recomputed.
  significance Int
  /// Human-readable, precomputed so the digest renderer does zero work.
  headline     String

  /// True for events reconstructed from source timestamps or Wayback at baseline.
  /// Backfilled events power charts but MUST NOT trigger alerts.
  backfilled Boolean @default(false)

  /// Idempotency key. Re-running a crawl cannot duplicate events.
  dedupeKey String

  detectedAt DateTime @default(now())
  /// When the event actually happened, if known (backfill). Defaults to detectedAt.
  occurredAt DateTime @default(now())

  @@unique([dedupeKey])
  @@index([storeId, occurredAt(sort: Desc)])
  @@index([storeId, significance(sort: Desc), occurredAt(sort: Desc)])
  @@index([eventType, occurredAt(sort: Desc)])
  /// Bounded per-product lifecycle lookups (Milestone 5B: persistence gap
  /// reconstruction, bestseller rank trajectory) — without this, a query
  /// scoped to one product's PRODUCT_REMOVED/RESTORED history only has the
  /// (storeId, occurredAt) prefix to work with and must filter entityKey
  /// out of every row in the time range, not just this product's rows.
  @@index([storeId, entityType, entityKey, occurredAt(sort: Desc)])
  @@schema("store_spy")
}

// ---------------------------------------------------------------------------
// Users, auth identities, and watchlists
//
// Auth model shape (User/Account/Session/VerificationToken) follows the
// standard Auth.js Prisma-adapter convention verbatim — do not rename these
// fields, the adapter reads/writes them by exact name.
// ---------------------------------------------------------------------------

/// Source of truth for plan-gated behavior. Nothing outside
/// src/lib/entitlements/ should ever compare this directly — go through
/// EntitlementService.hasCapability() instead.
enum PlanTier {
  FREE
  /// The paid tier introduced in Milestone 3 Sub-phase C: unlimited
  /// analyses, up to 20 active monitors, continuous (non-expiring)
  /// monitoring. Renamed from PRO (Sub-phase A never actually granted
  /// PRO to any user — no billing exists yet — so this rename carries
  /// no live data).
  BASIC
  BUSINESS

  @@schema("store_spy")
}

/// Coarse admin roles — fine-grained access is Permission (src/lib/admin/roles.ts),
/// never a raw role-string comparison in route/service code. SUPER_ADMIN is
/// bootstrap-only (scripts/grant-admin.ts); no HTTP route can grant it — see
/// PATCH /api/admin/users/[id]/role's own invariant checks.
///
/// Milestone 12 §2.3: MARKETING_ADMIN and MANAGER are the only two roles
/// added for the new org shape — everyone else gets a base role plus
/// per-user AdminPermissionGrant rows (§2.1) rather than a bespoke role per
/// employee. MANAGER is the union of SUPPORT_ADMIN and OPS_ADMIN plus
/// audit:read (see roles.ts's ROLE_PERMISSIONS for the literal set).
enum Role {
  USER
  ANALYST
  CONTENT_ADMIN
  SUPPORT_ADMIN
  BILLING_ADMIN
  OPS_ADMIN
  MARKETING_ADMIN
  MANAGER
  SUPER_ADMIN

  @@schema("store_spy")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  emailVerified          DateTime?
  name                   String?
  image                  String?
  /// Null for OAuth-only users. Set only via the Credentials provider's
  /// signup path, hashed with bcrypt — never stored or logged raw.
  passwordHash           String?
  plan                   PlanTier  @default(FREE)
  role                   Role      @default(USER)
  /// A JWT issued before this timestamp is rejected by the `jwt` callback
  /// (see auth.ts) even if it hasn't expired — the real "sign out
  /// everywhere" / compromised-account kill switch that JWT sessions
  /// otherwise can't offer (session strategy is JWT, not database; see
  /// auth.ts's own doc comment for why). Null means no floor: every
  /// existing token is still valid. Set via POST
  /// /api/admin/users/[id]/revoke-sessions in Phase 2.
  sessionsValidAfter     DateTime?
  /// Milestone 12 §1.4, per D1: anchored to account creation, never to first
  /// watch or first analysis — set once at insert time via a DB-level
  /// default (`now() + 30 days`) so every creation path (signup route,
  /// OAuth first sign-in through the Auth.js Prisma adapter, the admin
  /// bootstrap script) gets it uniformly with no risk of a missed call site.
  /// Only ever read for a FREE-plan user (monitoring/watch.ts); ignored for
  /// paid plans, so an upgrade never needs to null it back out.
  ///
  /// The `AT TIME ZONE 'UTC'` is not decorative — see AGENTS.md's Database
  /// time rule. Unlike Prisma's own `@default(now())` fields (createdAt,
  /// etc.), which Prisma's query engine populates client-side with an
  /// explicit, already-UTC-safe parameter and never actually invokes this
  /// column's SQL-level DEFAULT to do it, THIS default genuinely does fire
  /// at insert time for every real caller (prisma.user.create() has no
  /// client-side special-casing for a non-`now()` default expression).
  /// Confirmed live: with a non-UTC session TimeZone (Asia/Dhaka, this
  /// project's own dev Postgres — the exact scenario AGENTS.md documents),
  /// `now() + interval '30 days'` cast bare into this timestamp(3) column
  /// landed 6 hours off from `createdAt + 30 days`; wrapping the whole
  /// expression in `AT TIME ZONE 'UTC'` fixed it, verified against the same
  /// session.
  freeTrialEndsAt        DateTime? @default(dbgenerated("((now() + interval '30 days') AT TIME ZONE 'UTC')"))
  /// Milestone 12 §4.1: a SEPARATE, unticked-by-default opt-in — never
  /// bundled into ToS acceptance (bundled consent is not valid consent
  /// under GDPR/PECR). Defaults to `false` for every creation path,
  /// including OAuth first sign-in through the Auth.js Prisma adapter,
  /// which has no consent-checkbox moment at all: "no consent was ever
  /// asked or given" and "explicitly declined" are indistinguishable here
  /// by design, and both correctly mean "do not send marketing email."
  /// `POST /api/admin/users/export`'s `purpose:"marketing"` branch
  /// (analytics/user-export.ts) filters on this field — never on
  /// `emailVerified` or any other proxy.
  marketingConsent       Boolean   @default(false)
  /// Set only when `marketingConsent` is actually granted (`true`) — there
  /// is no "consent event" to timestamp when it's merely left at its
  /// default `false`. Read by `GET /api/unsubscribe` alongside
  /// `marketingConsentSource` as part of the record of what was granted,
  /// when, and from where; NOT cleared on unsubscribe (unsubscribeMarketing()
  /// only flips `marketingConsent` back to `false`) — the original grant
  /// timestamp/source stays the historical record of record, the same
  /// append-only-history spirit as `AdminAuditLog`.
  marketingConsentAt     DateTime?
  /// Free text, not an enum, matching `AdminAuditLog.action`'s own
  /// convention — a new consent-capture surface (e.g. a future checkout
  /// upsell) shouldn't require a migration. `"signup_form"` is the only
  /// value this milestone's own code ever writes.
  marketingConsentSource String?
  /// Milestone 12 §4.1 addendum: set the moment ToS is accepted, on
  /// EITHER signup path. Credentials signup sets it synchronously, in the
  /// same `create()` call as the row itself (the route already validates
  /// `tosAccepted === true` before allowing signup at all). OAuth first
  /// sign-in has no such moment — the Auth.js Prisma adapter creates this
  /// row directly with no consent step of its own — so it stays null
  /// until the post-OAuth consent interstitial (`/welcome`,
  /// `POST /api/account/consent`) sets it. Null is the ONE condition
  /// `DashboardLayout` checks (a fresh read, not the JWT — see its own
  /// comment for why) to gate access: no dashboard page renders for an
  /// account that has never accepted, regardless of which path created it.
  /// Never backdated for pre-existing accounts created before this field
  /// existed — fabricating a consent timestamp that was never actually
  /// given would defeat the entire point; those accounts see the
  /// interstitial once, the same as any other un-consented account.
  tosAcceptedAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  watchlists       Watchlist[]
  analysisUsage    AnalysisUsage[]
  /// Grants held BY this user — see AdminPermissionGrant's own doc comment
  /// for why grantedByUserId (the OTHER direction) is deliberately not a
  /// second relation here.
  permissionGrants AdminPermissionGrant[]

  @@index([role])
  @@schema("store_spy")
}

/// Append-only, in the same transaction as the change it records (see
/// recordAdminAction() in src/lib/admin/audit.ts) — if the audit write
/// fails, the change it was recording rolls back with it. `actorId`/
/// `targetId` are plain Strings, not FK relations to User — deliberately,
/// so a later `User` deletion never cascades into this table structurally.
///
/// Exactly one narrow, deliberate exception to "no update path exists":
/// Milestone 12 §4.1's GDPR Art. 17 self-service account deletion
/// (`src/lib/account/delete.ts`) tombstones — never deletes — every row
/// where `actorId` or (`targetType = "User"` and) `targetId` matches the
/// erased user, replacing that id with a stable, non-reversible
/// `deleted:<originalId>` marker and redacting `actorEmail` to a fixed
/// placeholder. "An audit log that can be erased by its subject is not an
/// audit log" — the fact that an action happened, when, and what it was
/// survives; the erased person's own identifying details do not. This is a
/// genuine narrowing of the original "actorEmail is denormalized so the
/// log stays readable even after the actor's own account is gone" design:
/// that reasoning holds for an ADMIN employee's account being deprovisioned
/// (readability matters more than an internal employee's email staying
/// visible forever), but not for a paying CUSTOMER's own GDPR erasure
/// request, which is a real legal obligation to actually remove their PII.
/// `metadata` (a free-form JSON blob whose shape varies per `action`) is
/// NOT scrubbed by this tombstoning — a known, disclosed limitation, not an
/// oversight; some actions (e.g. `subscription.expire`) embed a `userEmail`
/// field there that a full metadata-level PII scrubber would need to
/// understand per action type. See the Milestone 12 completion report.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@schema("store_spy")
}

/// Milestone 12 §2.1: per-employee permission grants layered ON TOP of the
/// role matrix — never a replacement for it. Additive only, by construction
/// of how effectivePermissions() (roles.ts) combines the two: a grant can
/// only ever widen a user's effective set beyond their role's baseline,
/// never narrow it. Narrowing is done by changing the role.
///
/// Append-only, same discipline as AdminAuditLog: a row is never deleted,
/// and revocation/expiry both work by SETTING revokedAt, never by removing
/// the row — "the audit trail must survive" is the doc's own words. A grant
/// that later expires on its own (expiresAt reached) is ALSO marked
/// revokedAt by the worker's sweep (expireDuePermissionGrants(),
/// scripts/worker.ts) so "is this grant currently active" is always a
/// single `revokedAt IS NULL` check at the DB level — permissions-service.ts's
/// own live queries additionally re-check expiresAt directly (not just
/// relying on the sweep having already run), so a grant stops applying the
/// instant it expires, not up to one worker-tick-interval later; the sweep
/// exists for the audit trail's bookkeeping, not as the enforcement
/// mechanism.
///
/// `permission` is a plain String, not an enum, matching AdminAuditLog's
/// own `action`/`targetType` convention — a new Permission value should
/// never require a migration. `grantedByUserId` is deliberately a plain
/// field, NOT a relation: the granting admin's own User row may later be
/// deleted (deprovisioned), and the grant they issued to someone ELSE must
/// keep working — the exact same "denormalized so the log stays readable
/// after the actor's own User row is deleted" reasoning as
/// AdminAuditLog.actorEmail. The TARGET (userId) relation, by contrast, DOES
/// cascade — once the target user themselves is gone there's nothing left
/// to apply the grant to, and AdminAuditLog already preserves the
/// permanent, human-readable record of the grant/revoke actions themselves.
///
/// A partial unique index — `CREATE UNIQUE INDEX ... ON ("userId",
/// "permission") WHERE "revokedAt" IS NULL` — is added by hand in this
/// migration's SQL (Prisma's schema DSL has no way to express a WHERE
/// clause on @@unique, and Postgres partial-index predicates must be
/// immutable, so it can only check revokedAt IS NULL, not also `expiresAt >
/// now()`) as defense in depth alongside grantPermission()'s own
/// advisory-lock + check-then-insert; not declared as @@unique here since
/// Prisma would then try to manage a plain (non-partial) constraint that
/// doesn't match what's actually in the database.
model AdminPermissionGrant {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission      String
  grantedByUserId String
  grantedAt       DateTime  @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?

  @@index([userId, permission])
  @@index([expiresAt])
  @@schema("store_spy")
}

/// One row per credentials-login attempt, success or failure — the durable,
/// shared-across-instances backing store for login-throttle.ts. Deliberately
/// NOT the in-memory rate limiter (rate-limit.ts): lockout state must
/// survive a process restart and be visible to every instance, which an
/// in-memory Map by definition cannot do. Tracked per email AND per IP
/// independently (see login-policy.ts) since a shared NAT makes per-IP
/// thresholds necessarily looser than per-account ones. Append-only by
/// design — a successful login clears the offending rows rather than
/// leaving them to accumulate, but nothing here is ever UPDATEd.
model LoginAttempt {
  id              String   @id @default(cuid())
  /// Null when the submitted email was missing/malformed — see
  /// login-throttle.ts. normalizeEmail()'d, matching User.email.
  emailNormalized String?
  /// getClientIp()'s output — "unknown" is a legitimate, if coarse, shared bucket.
  ipKey           String?
  succeeded       Boolean
  createdAt       DateTime @default(now())

  @@index([emailNormalized, createdAt])
  @@index([ipKey, createdAt])
  @@schema("store_spy")
}

/// One row per linked OAuth identity (Google, Facebook, ...). A single User
/// can have multiple Accounts; this is the "identity/account relationship"
/// that keeps sign-in-with-Google and sign-in-with-Facebook from ever
/// silently creating two Users for the same person.
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@schema("store_spy")
}

/// DB-backed sessions (not JWT) — chosen so a session can be revoked
/// server-side (sign-out-everywhere, account compromise) without waiting
/// for a token to expire.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@schema("store_spy")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("store_spy")
}

enum WatchStatus {
  ACTIVE
  EXPIRED
  REMOVED

  @@schema("store_spy")
}

/// The per-user monitoring relationship (spec: "StoreWatch"). Deliberately
/// extends the pre-existing Watchlist model rather than introducing a
/// competing one — same (userId, storeId) shape it already had.
/// monitoringStartedAt/ExpiresAt/Status are the monitoring mechanism;
/// Store.tier (global, shared) is promoted to HOT while this is ACTIVE and
/// demoted back to COLD once no ACTIVE watch remains for that store, via
/// recomputeStoreTier() in monitoring/watch.ts.
///
/// How many ACTIVE rows a single userId may have is plan-dependent (FREE:
/// 1, BASIC: 20) — see entitlements/plan-limits.ts — so it's enforced
/// entirely in the service layer (advisory-lock + COUNT, same pattern as
/// AnalysisUsage's "at most N" check), not by a DB constraint: a unique
/// index can express "at most one," never "at most N." An earlier
/// migration added a partial unique index assuming FREE's N=1 was
/// universal; it was dropped once BASIC needed N=20 — see
/// 20260811_basic_plan_and_unlimited_watch/migration.sql.
///
/// monitoringExpiresAt is null for BASIC's continuous monitoring (no fixed
/// end date) — expireDueWatches()'s SQL comparison against NULL naturally
/// never matches, so a null-expiry watch is simply never swept.
model Watchlist {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  addedAt        DateTime  @default(now())
  /// Minimum significance required to send a real-time alert. Everything
  /// below this still lands in the weekly digest. Unused until the alerts
  /// feature (explicitly out of scope this milestone) ships.
  alertThreshold Int       @default(60)
  lastDigestAt   DateTime?

  monitoringStartedAt DateTime?
  monitoringExpiresAt DateTime?
  monitoringStatus    WatchStatus @default(ACTIVE)

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId, monitoringStatus])
  @@index([monitoringStatus, monitoringExpiresAt])
  @@schema("store_spy")
}

/// Milestone 12 §1.2: the server-side usage ledger for the rolling
/// "analyses per 24h" quota — append-only, one row per analysis RUN, not per
/// unique store. Before this milestone the table answered "how many unique
/// stores has this user ever analyzed" (a `@@unique([userId, storeId])`
/// lifetime-count model); the product now needs "how many analyses in the
/// last 24 hours", which requires the same store to be able to appear more
/// than once (a fresh analysis of it after the window resets is a genuine
/// new analysis run). hasAnalyzedStore() (src/lib/entitlements/) still
/// answers the separate, PERMANENT question "has this user ever analyzed
/// this store at all" — that grants lasting `full` report access
/// (resolveStoreAccess(), Milestone 11 §1.3) and is unaffected by the
/// windowing change; it becomes an EXISTS-shaped query instead of a unique
/// lookup, same answer. Never trust a client-supplied count; this table is
/// the only source of truth. See recordAnalysisUsage() for the
/// advisory-lock pattern that keeps concurrent requests from a user with one
/// credit left from consuming two.
model AnalysisUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// The windowed quota query's covering index (countAnalysesInWindow()).
  @@index([userId, createdAt])
  /// Non-unique now (the lifetime uniqueness constraint is gone) — still
  /// needed so hasAnalyzedStore()'s EXISTS query and the D2 same-store/
  /// same-window dedup check inside recordAnalysisUsage() stay index-backed.
  @@index([userId, storeId])
  @@schema("store_spy")
}

/// Milestone 12 §1.3: the DB-backed ledger behind the anonymous 3-per-24h
/// quota (POST /api/analyze without a session) — deliberately NOT the
/// in-memory rate limiter (rate-limit.ts), which can't hold a 24-hour window
/// across a process restart. `ipKey` is getClientIp()'s output — the FIXED
/// version (Milestone 11 fix 1.1); keying this on the pre-fix extraction
/// would have made the quota free to bypass with a spoofed
/// x-forwarded-for prefix. Also backs the global hourly circuit breaker
/// (ANONYMOUS_CRAWL_HOURLY_CEILING) via a count with no ipKey filter.
model AnonymousAnalysis {
  id     String @id @default(cuid())
  ipKey  String
  /// Canonicalized domain the probe targeted — informational only (abuse
  /// investigation, admin visibility). Deliberately not a Store foreign
  /// key: an anonymous probe never creates a Store row (Milestone 11 fix
  /// 1.5, preserved here — see analysis/anonymous-probe.ts), and most
  /// probed domains never get one at all.
  domain String

  createdAt DateTime @default(now())

  @@index([ipKey, createdAt])
  /// The circuit breaker's own query shape — global count in the last hour, no ipKey filter.
  @@index([createdAt])
  @@schema("store_spy")
}

// ---------------------------------------------------------------------------
// Marketing intelligence — Google advertising (Milestone 4 Sub-phase B)
//
// Store-scoped, never User-scoped: one shared dataset per store regardless
// of how many users watch/analyze it. Kept as a separate pipeline from the
// Shopify crawler (see MarketingCollectionRun, the Crawl-vs-Product
// equivalent for this domain: an individual AdObservation row cannot
// represent "we tried and failed to check").
//
// Vendor-agnostic by design (AdPlatform currently has one member, GOOGLE)
// so a future Meta source is additive, not a rewrite.
// ---------------------------------------------------------------------------

enum AdPlatform {
  GOOGLE

  @@schema("store_spy")
}

/// Outcome of one collection attempt against the vendor. Never conflated with
/// "no ads found" — see MarketingCollectionRun.reason and the AdObservation
/// absence policy below.
enum MarketingCollectionOutcome {
  SUCCESS
  UNAVAILABLE

  @@schema("store_spy")
}

/// One row per collection attempt, successful or not. Exists specifically so
/// a failed/unavailable check is a recorded fact, never silently absent —
/// mirrors the existing Crawl model's role for the Shopify pipeline.
model MarketingCollectionRun {
  id       String     @id @default(cuid())
  storeId  String
  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform AdPlatform

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  outcome MarketingCollectionOutcome?
  /// Set only when outcome = UNAVAILABLE. Distinguishes e.g. "vendor
  /// unavailable" from "advertiser identification unavailable" — never
  /// collapsed into a single generic failure string.
  reason  String?

  /// Set only when outcome = SUCCESS.
  adsObserved        Int?
  vendorRequestCount Int  @default(0)

  @@index([storeId, platform, startedAt(sort: Desc)])
  @@schema("store_spy")
}

/// ACTIVE_EVIDENCE: the most recent successful check still returned this ad.
/// HISTORICAL: confirmed absent per the absence policy (missingStreak
/// threshold reached on successful checks — never on a failed/unavailable
/// run). Mirrors StoreEntity's ACTIVE -> MISSING -> REMOVED shape, collapsed
/// to two states because a single-poll "missing" is not yet meaningful here.
enum AdObservationStatus {
  ACTIVE_EVIDENCE
  HISTORICAL

  @@schema("store_spy")
}

/// How matchedProduct was derived. Deterministic only — no AI/embeddings/
/// fuzzy matching. Exact URL match against the store's own product catalog
/// path. (Collection-page destination URLs are deliberately not modeled as
/// a "match" — AdObservation only has a Product FK, and inventing a second
/// matched-entity shape for collections isn't justified without a concrete
/// use case. Such an ad is simply left unmatched.)
enum MatchMethod {
  EXACT_PRODUCT_URL

  @@schema("store_spy")
}

enum MatchConfidence {
  HIGH
  MEDIUM
  LOW

  @@schema("store_spy")
}

/// One row per distinct ad, identified by the vendor's own stable
/// externalAdId — NEVER by destination URL alone (multiple ads can point to
/// the same product). Append-only current-state table, same role as Product:
/// history of what changed lives in Event, not here.
model AdObservation {
  id       String     @id @default(cuid())
  storeId  String
  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform AdPlatform

  /// Vendor's stable ad/creative ID. The real identity key for dedup —
  /// destination URL is explicitly not used for identity.
  externalAdId         String
  advertiserExternalId String?
  advertiserName       String?
  destinationUrl       String?
  /// Free text ("text" | "image" | "video") — vendor-supplied, not modeled
  /// as an enum since the vendor's own vocabulary may grow.
  format               String?

  status        AdObservationStatus @default(ACTIVE_EVIDENCE)
  /// Consecutive successful checks in which this ad was absent. Never
  /// incremented on a failed/unavailable MarketingCollectionRun.
  missingStreak Int                 @default(0)

  matchedProductId String?
  matchedProduct   Product?         @relation(fields: [matchedProductId], references: [id], onDelete: SetNull)
  matchMethod      MatchMethod?
  matchConfidence  MatchConfidence?

  firstSeenAt DateTime
  lastSeenAt  DateTime

  /// e.g. "SERPAPI_GOOGLE_ADS_TRANSPARENCY_CENTER" — which vendor/endpoint
  /// produced this row. Free text, not an enum: new vendors under the same
  /// AdPlatform shouldn't require a migration.
  source         String
  sourceMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, platform, externalAdId])
  @@index([storeId, status])
  @@index([matchedProductId])
  @@schema("store_spy")
}

// ---------------------------------------------------------------------------
// Billing — promo codes and checkout (Milestone 11, Phase 3)
//
// There is no payment provider in this repo — see billing/checkout.ts's own
// doc comment for the marked PROVIDER SEAM. Every model here must still be
// fully correct for the zero-provider path (a 100%-off promo), since that
// path is the one thing this phase makes fully functional end to end.
// ---------------------------------------------------------------------------

enum DiscountType {
  PERCENT
  FIXED

  @@schema("store_spy")
}

enum PromoStatus {
  ACTIVE
  DISABLED

  @@schema("store_spy")
}

enum CheckoutStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED

  @@schema("store_spy")
}

enum SubscriptionSource {
  PROMO
  PROVIDER
  MANUAL

  @@schema("store_spy")
}

/// ACTIVE until swept past its own expiresAt (or manually superseded).
/// EXPIRED is terminal — see expireDueSubscriptions() in
/// billing/subscription-sweep.ts. Needed as its own field (not just a null
/// check on expiresAt) because a null-expiry (perpetual) Subscription is
/// still meaningfully ACTIVE forever and must never be swept.
enum SubscriptionStatus {
  ACTIVE
  EXPIRED

  @@schema("store_spy")
}

/// Immutable after creation — see promo.ts's own doc comment on why a
/// redemption row's recorded amounts must always be reconcilable against
/// terms that never changed out from under it. To change terms, disable and
/// mint a new code.
model PromoCode {
  id               String       @id @default(cuid())
  /// Normalized (uppercase, no whitespace/dashes) — see promo-code.ts. The
  /// unique index is on this normalized form so "abc-def" and "ABCDEF"
  /// can never both exist as distinct rows.
  code             String       @unique
  discountType     DiscountType
  /// PERCENT: integer 1-100. FIXED: integer cents, >= 1.
  discountValue    Int
  /// Null means valid against any plan.
  appliesToPlan    PlanTier?
  /// Null means unlimited total redemptions.
  maxRedemptions   Int?
  perUserLimit     Int          @default(1)
  validFrom        DateTime
  validUntil       DateTime?
  status           PromoStatus  @default(ACTIVE)
  /// Set only for a promo minted for one specific person — see promo.ts's
  /// not_assigned_to_you handling (masked as not_found at the route layer).
  assignedToUserId String?
  createdByUserId  String
  /// Milestone 11 Phase 3 §3.4 amendment: how long the GRANTED plan lasts,
  /// carried to Subscription.expiresAt at redemption. Null is perpetual —
  /// deliberately not a default that falls out of omission: an admin must
  /// choose explicitly (see the admin promo-creation route), because a
  /// promo that grants a plan forever by accident is a real revenue leak,
  /// not a convenience.
  durationDays     Int?
  createdAt        DateTime     @default(now())

  redemptions PromoRedemption[]

  @@index([status])
  @@index([assignedToUserId])
  @@schema("store_spy")
}

/// One row per successful redemption. Append-only — the whole point of
/// keeping PromoCode immutable is that this row's recorded amounts can
/// always be reconciled against it later.
model PromoRedemption {
  id             String    @id @default(cuid())
  promoCodeId    String
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId         String
  checkoutId     String?
  listPriceCents Int
  discountCents  Int
  finalCents     Int
  createdAt      DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@index([promoCodeId])
  @@schema("store_spy")
}

model Checkout {
  id             String         @id @default(cuid())
  userId         String
  plan           PlanTier
  period         String
  promoCodeId    String?
  listPriceCents Int
  discountCents  Int
  finalCents     Int
  status         CheckoutStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  @@index([userId])
  @@index([status, createdAt])
  @@schema("store_spy")
}

/// The billing-relationship record a promo grant (or, later, a real
/// provider subscription) creates. `status`/`expiresAt` are read by
/// expireDueSubscriptions() (billing/subscription-sweep.ts, run from the
/// worker tick) — a perpetual grant (expiresAt: null) is simply never
/// matched by that sweep's query, the same NULL-comparison behavior
/// monitoring/watch.ts's expireDueWatches() already relies on for FREE's
/// non-expiring monitor.
model Subscription {
  id        String             @id @default(cuid())
  userId    String
  plan      PlanTier
  source    SubscriptionSource
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())

  @@index([userId])
  @@index([status, expiresAt])
  @@schema("store_spy")
}

// ---------------------------------------------------------------------------
// Super admin analytics — Milestone 12 Phase 3
//
// Every number the admin analytics dashboard renders is a full aggregate
// scan over Event/Crawl/AnalysisUsage/etc. (see src/lib/admin/analytics/) —
// deliberately never run synchronously on a page load. computeAndStoreSnapshots()
// (analytics/snapshot.ts) runs from the worker tick, self-gated to hourly,
// and writes one row per (metricKey, dimension, windowStart, windowEnd) here;
// Server Components under /admin/analytics read ONLY this table.
// ---------------------------------------------------------------------------

/// `dimension` is a plain, always-non-null String (default ""), not
/// String? — a nullable column would let Postgres treat two rows with the
/// same (metricKey, NULL, windowStart, windowEnd) as non-duplicates under a
/// unique index (NULL <> NULL), silently defeating the upsert-in-place
/// design below. "" is the explicit spelling of "this metric has no
/// sub-breakdown" (e.g. total signups in the window), matching a real
/// dimension value like a PlanTier or a cohort month ("2026-07") for
/// metrics that have one.
///
/// windowStart/windowEnd both identify a POINT-IN-TIME metric (equal
/// values — e.g. "MRR right now") and a WINDOWED one (e.g. "new MRR in the
/// last 30 days", or one calendar day/month bucket for a trend chart) with
/// the same two columns, so every metric group shares one storage shape.
/// The @@unique below is deliberately also the upsert key: recomputing a
/// metric whose window is pinned to a calendar boundary (a cohort month, a
/// trend chart's day) overwrites `value`/`computedAt` in place for free. A
/// ROLLING window (the standard 1d/7d/30d/90d dashboard tiles) instead
/// advances its windowEnd every run, so upserting alone would grow one new
/// row per metric per hourly tick forever — analytics/snapshot.ts's
/// pruneStaleRolledUpRows() deletes the previous run's now-stale row for
/// those, keeping this table's rolling-window rows at O(metrics) rather
/// than O(metrics × ticks).
model MetricSnapshot {
  id          String   @id @default(cuid())
  metricKey   String
  dimension   String   @default("")
  windowStart DateTime
  windowEnd   DateTime
  value       Float
  computedAt  DateTime @default(now())

  @@unique([metricKey, dimension, windowStart, windowEnd])
  /// The dashboard's own read shape: "latest value(s) for this metric,
  /// most recent window first" — see analytics/read.ts.
  @@index([metricKey, dimension, windowEnd(sort: Desc)])
  @@schema("store_spy")
}

// ---------------------------------------------------------------------------
// Marketing conversion events — Milestone 12 §4.2 Step 2
//
// "Prefer server-side conversion APIs where they exist... Server-side
// events go out from the worker, not the request path." This is that
// queue: a signup route write (fast, local, in the request path) and a
// separate worker read+dispatch (the actual outbound vendor call, off the
// request path entirely) — never a synchronous call to a vendor's API from
// inside an HTTP handler.
// ---------------------------------------------------------------------------

enum MarketingConversionEventType {
  SIGNUP

  @@schema("store_spy")
}

/// PENDING -> DISPATCHED (success) or FAILED (real vendor error, retriable)
/// or SKIPPED_NO_CREDENTIAL (no vendor secret configured yet — §4.3 hasn't
/// shipped the credential vault this milestone; a documented, expected
/// steady state today, not a failure to alert on). Never deleted — even a
/// SKIPPED/FAILED row is a real record that a conversion was DUE and
/// couldn't be reported, useful once §4.3 lands to know what to backfill.
enum MarketingConversionDispatchStatus {
  PENDING
  DISPATCHED
  SKIPPED_NO_CREDENTIAL
  FAILED

  @@schema("store_spy")
}

/// One row per (event, vendor) — a signup with two vendors configured
/// writes two rows, dispatched and retried independently. Deliberately
/// stores NO PII beyond `userId` — the same minimization discipline this
/// milestone's own audit-metadata addendum established (store the id,
/// look up whatever's needed at the point of actual use, never a frozen
/// copy). `vendor` is a plain String, not an enum, matching
/// AdObservation.source/AdminAuditLog.action's own convention — adding a
/// second vendor should never need a migration.
model MarketingConversionEvent {
  id             String                            @id @default(cuid())
  eventType      MarketingConversionEventType
  vendor         String
  userId         String
  occurredAt     DateTime                          @default(now())
  dispatchStatus MarketingConversionDispatchStatus @default(PENDING)
  dispatchedAt   DateTime?
  dispatchError  String?

  /// The worker's own claim query shape — "give me what's still due."
  @@index([dispatchStatus, occurredAt])
  @@index([userId])
  @@schema("store_spy")
}

// ---------------------------------------------------------------------------
// B2 step 1 — new homes for two store_spy.User columns that stay
// product-specific (see docs/store-spy-control-plane-b2.md, Q2 and Q5).
//
// Both are keyed by control_plane.users.id. The foreign key to
// control_plane.users is added in raw migration SQL, not here: Prisma's DSL
// cannot put a second @relation on a column, and during B2 steps 1–3 these
// ids also still satisfy the (soon-dropped) store_spy.User FK. `userId` is
// therefore a plain String in the schema.
// ---------------------------------------------------------------------------

/// B2 TEMPORARY home for store_spy.User.role. Staff/customer separation is
/// deferred to B2.5 (Q2) — at which point admin identities move to
/// control_plane.staff / staff_roles and this table is retired. Only
/// non-USER roles get a row; absence means USER. Keeps the "last SUPER_ADMIN"
/// guard (account/delete.ts, users-service.ts) working as a COUNT over this
/// table.
model UserAdminRole {
  userId String @id
  role   Role

  @@index([role])
  @@map("UserAdminRole")
  @@schema("store_spy")
}

/// store_spy.User's marketing-consent fields, unchanged in meaning. Kept
/// per-product (Q5): Store Spy consent is not Find Suppliers consent. Same
/// append-the-grant-timestamp discipline as before — unsubscribe flips
/// `consent` to false but never clears `consentAt` / `consentSource`.
model MarketingConsent {
  userId        String    @id
  consent       Boolean   @default(false)
  consentAt     DateTime? @map("consent_at")
  consentSource String?   @map("consent_source")

  @@map("MarketingConsent")
  @@schema("store_spy")
}

// ===========================================================================
// CONTROL PLANE  (schema: control_plane)
//
// The shared identity / billing / entitlements layer, per
// docs/store-spy-rebrand-and-control-plane.md Task B. A customer who buys
// both Store Spy and the forthcoming Find Suppliers is ONE account here, not
// two. This block is structure only — B1 creates the tables and seeds
// `products`; B2 migrates Store Spy's users into `control_plane.users` and
// moves session issuance. Nothing in src/ reads these tables yet except the
// internal entitlements endpoint (B3).
//
// Four rules encoded here, from the task doc — do not "simplify" them away:
//   1. `Staff` and `CpUser` are separate tables, never merged. No is_admin
//      flag on users. Employees and customers have different lifecycles and
//      blast radius.
//   2. `Account` owns subscriptions, not `CpUser`. One-user accounts today;
//      team seats later need no rewrite.
//   3. `isSuperadmin` is a column on `Staff`, never a row in `StaffRole` —
//      it cannot be granted through the ordinary role-assignment path.
//   4. `StaffRole` is scoped per product, so a marketing hire can get
//      Find Suppliers access without Store Spy customer data.
//
// Prisma model names carry a `Cp` prefix only to avoid colliding with the
// store_spy models (`Account`, `User`, `Subscription`, ... already exist).
// The tables and columns themselves are plain snake_case, matching the
// task doc's B1 spec, since the Find Suppliers codebase and support tooling
// will query them directly by name.
// ===========================================================================

/// A billing customer. Owns subscriptions and one-or-more users. Created
/// one-per-signup by Store Spy today (B2); team seats are a later addition
/// that needs no schema change here.
model CpAccount {
  id                 String   @id @default(cuid())
  /// The address invoices/receipts go to. Not necessarily any user's login
  /// email — deliberately separate so changing a login never silently
  /// redirects billing mail.
  billingEmail       String   @map("billing_email")
  /// The payment provider's own customer handle (Polar/Paddle/etc.), once a
  /// provider exists. Null until then — see billing/checkout.ts's PROVIDER
  /// SEAM. Unique when present so a provider customer maps to exactly one
  /// account.
  providerCustomerId String?  @unique @map("provider_customer_id")
  createdAt          DateTime @default(now()) @map("created_at")

  users         CpUser[]
  subscriptions CpSubscription[]

  @@map("accounts")
  @@schema("control_plane")
}

/// OWNER is the account's billing/admin contact; MEMBER is a plain seat.
/// Store Spy creates every account with exactly one OWNER today.
enum CpAccountRole {
  OWNER
  MEMBER

  @@map("account_role")
  @@schema("control_plane")
}

/// A customer login. Belongs to exactly one account. This is where Store
/// Spy's `User` rows move in B2 — at which point store_spy keeps only its
/// domain data, joined by a `control_plane.users.id`.
model CpUser {
  id           String        @id @default(cuid())
  accountId    String        @map("account_id")
  account      CpAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email        String        @unique
  /// Null for OAuth-only users, same as store_spy's User.passwordHash.
  passwordHash String?       @map("password_hash")
  accountRole  CpAccountRole @default(OWNER) @map("account_role")
  createdAt    DateTime      @default(now()) @map("created_at")

  // --- B2 step 1: identity columns migrated off store_spy.User. Nullable so
  // the additive migration doesn't need a value for every column on every
  // pre-existing row; the backfill populates them. `plan` and
  // `freeTrialEndsAt` are deliberately absent — those become derived from
  // control_plane.subscriptions / entitlements (see docs/store-spy-control-plane-b2.md).
  emailVerifiedAt    DateTime? @map("email_verified_at")
  sessionsValidAfter DateTime? @map("sessions_valid_after")
  name               String?
  image              String?
  /// Terms of Service acceptance — with the company (Bellwether Intelligence),
  /// not the product, so it lives here rather than in a store_spy table (Q5).
  tosAcceptedAt      DateTime? @map("tos_accepted_at")

  @@index([accountId])
  @@map("users")
  @@schema("control_plane")
}

/// The product catalogue. Seeded in this migration with `store-spy` and
/// `find-suppliers` (the second row costs nothing and makes the
/// multi-product assumption concrete — the task doc's own instruction).
model CpProduct {
  id   String @id @default(cuid())
  slug String @unique
  name String

  subscriptions CpSubscription[]
  staffRoles    StaffRole[]

  @@map("products")
  @@schema("control_plane")
}

/// TRIALING is Store Spy's 30-day free monitoring window modelled as a real
/// subscription (period_end = signup + 30d) rather than a `User` column —
/// see the freeTrialEndsAt inventory in the B1 hand-off. ACTIVE is a paid
/// or promo-granted plan. The rest are provider-driven lifecycle states
/// that only start being written once a payment provider is wired.
enum CpSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED

  @@map("subscription_status")
  @@schema("control_plane")
}

/// One row per (account, product) billing relationship. An account may
/// accumulate several over time for the same product (an expired trial, then
/// a paid plan) — the entitlements endpoint picks the current one
/// (status TRIALING/ACTIVE, latest period_end), so there is deliberately no
/// unique on (account_id, product_id).
model CpSubscription {
  id          String               @id @default(cuid())
  accountId   String               @map("account_id")
  account     CpAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId   String               @map("product_id")
  product     CpProduct            @relation(fields: [productId], references: [id])
  status      CpSubscriptionStatus
  /// Null = perpetual (a paid plan with no fixed end). A TRIALING row always
  /// has one. Same NULL-means-never-expire convention as store_spy's
  /// Subscription.expiresAt and Watchlist.monitoringExpiresAt.
  periodEnd   DateTime?            @map("period_end")
  /// The provider's subscription handle, once one exists. Null until then.
  providerRef String?              @map("provider_ref")
  createdAt   DateTime             @default(now()) @map("created_at")

  entitlements CpEntitlement[]

  @@index([accountId, productId, status])
  @@map("subscriptions")
  @@schema("control_plane")
}

/// What a subscription grants. `feature_key` is the permanent pricing
/// vocabulary — product-slug-prefixed (`store_spy.analysis.run`,
/// `store_spy.monitoring.slots`, `store_spy.intelligence.advanced`) because
/// entitlements are shared across products and the key is read in logs,
/// support tooling and pricing copy where the product_id join isn't visible.
///
/// `quota` is the ceiling only — null means a boolean capability or an
/// unlimited allowance, a number means a countable one. The control plane
/// does NOT do the counting: Store Spy's two real quotas are a rolling-24h
/// window (analysis.run) and a live COUNT of ACTIVE watches
/// (monitoring.slots), neither of which is a cumulative integer the control
/// plane can compute. The entitlements endpoint returns `quota` + `allowed`
/// (from subscription status/expiry only) + `reason`; the consuming product
/// owns the used-vs-quota comparison, under whatever lock its write path
/// already uses (recordAnalysisUsage()'s advisory lock, startMonitoring()'s
/// COUNT).
///
/// `used` is therefore UNUSED today — kept for a future genuinely cumulative
/// quota (e.g. "N exports ever") that the control plane could own end to end.
/// Nothing reads or writes it in B1.
model CpEntitlement {
  id             String         @id @default(cuid())
  subscriptionId String         @map("subscription_id")
  subscription   CpSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  featureKey     String         @map("feature_key")
  quota          Int?
  /// Reserved for future cumulative quotas — see the model doc comment. Not
  /// read or written anywhere as of B1.
  used           Int            @default(0)

  @@unique([subscriptionId, featureKey])
  @@map("entitlements")
  @@schema("control_plane")
}

/// An employee. A wholly separate table from CpUser (rule 1): different
/// auth, different lifecycle, different blast radius. `isSuperadmin` is a
/// column here (rule 3) so it can never be handed out through the ordinary
/// StaffRole assignment path.
model Staff {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  isSuperadmin Boolean  @default(false) @map("is_superadmin")
  createdAt    DateTime @default(now()) @map("created_at")

  roles StaffRole[]

  @@map("staff")
  @@schema("control_plane")
}

/// Per-product role assignment for an employee (rule 4). `role` is a plain
/// String, not an enum — matching this codebase's established convention for
/// role/permission/action strings (AdminAuditLog.action,
/// AdminPermissionGrant.permission): a new role should never need a
/// migration. Superadmin is NOT expressible here — it is Staff.isSuperadmin.
model StaffRole {
  id        String    @id @default(cuid())
  staffId   String    @map("staff_id")
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  productId String    @map("product_id")
  product   CpProduct @relation(fields: [productId], references: [id])
  role      String

  @@unique([staffId, productId, role])
  @@index([productId])
  @@map("staff_roles")
  @@schema("control_plane")
}

/// Cross-cutting audit trail for the control plane. `actor_type` /
/// `actor_id` / `action` / `target` are plain strings with NO foreign keys
/// — the same discipline as store_spy's AdminAuditLog: a staff or user
/// deletion must never cascade into the trail. `actor_type` is e.g.
/// "staff" | "user" | "system".
model CpAuditLog {
  id        String   @id @default(cuid())
  actorType String   @map("actor_type")
  actorId   String   @map("actor_id")
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorType, actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
  @@schema("control_plane")
}
